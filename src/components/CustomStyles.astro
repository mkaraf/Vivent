---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: #7C8B67; /* dh-dark-green */
    --aw-color-secondary: #AEC790; /* dh-light-green */
    --aw-color-accent: #A18260; /* dh-soft-brown */

    --aw-color-text-heading: #5A4232; /* dh-text-brown */
    --aw-color-text-default: #5A4232; /* dh-text-brown */
    --aw-color-text-muted: rgba(90, 66, 50, 0.66); /* dh-text-brown with opacity */
    --aw-color-bg-page: #F5EDE1; /* dh-cream */

    --aw-color-bg-page-dark: #5A4232; /* dh-text-brown */

    ::selection {
      background-color: #EADDCB; /* dh-light-beige */
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: #AEC790; /* dh-light-green */
    --aw-color-secondary: #7C8B67; /* dh-dark-green */
    --aw-color-accent: #A18260; /* dh-soft-brown */

    --aw-color-text-heading: #F5EDE1; /* dh-cream */
    --aw-color-text-default: #EADDCB; /* dh-light-beige */
    --aw-color-text-muted: rgba(234, 221, 203, 0.66); /* dh-light-beige with opacity */
    --aw-color-bg-page: #5A4232; /* dh-text-brown */

    ::selection {
      background-color: #7C8B67; /* dh-dark-green */
      color: #F5EDE1; /* dh-cream */
    }
  }
</style>
