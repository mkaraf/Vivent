---
import { Icon } from 'astro-icon/components';
import SectionHeading from './SectionHeading.astro';

const { id } = Astro.props;

const values = [
  { icon: "tabler:heart", title: "Šetrný přístup", text: "Ošetření bez stresu a bolesti. Postupujeme citlivě a s respektem k Vašemu komfortu." },
  { icon: "tabler:leaf", title: "Moderní vybavení", text: "Pracujeme s technologií AirFlow a metodou GBT pro maximální šetrnost a precizní výsledek." },
  { icon: "tabler:clock", title: "Čas na Vás", text: "Žádné spěchání. Každá návštěva má dostatek prostoru na vyšetření i konzultaci." },
];

const certs = ["Certifikace AirFlow / GBT", "Dentální hygienistka", "Individuální plán péče", "Šetrné ošetření"];
---
<section {...id ? { id } : {}} class="relative scroll-mt-24 py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <SectionHeading
      eyebrow="O nás"
      title={'Studio, kde se cítíte <span class="italic text-primary-deep">jako doma</span>'}
      intro="SanaDenta je nové dentální studio ve Zlíně. Vznikla s jasnou vizí — věnovat každému pacientovi čas, péči a klidné prostředí, které si zaslouží."
    />

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {values.map((v) => (
        <div class="group rounded-3xl border border-border/70 bg-card/80 p-7 transition hover:-translate-y-1 hover:border-primary/40" style="box-shadow: var(--shadow-soft);">
          <div class="grid h-12 w-12 place-items-center rounded-2xl bg-primary/15 text-primary-deep transition group-hover:bg-primary/25">
            <Icon name={v.icon} class="h-5 w-5" />
          </div>
          <h3 class="mt-5 font-display text-2xl text-foreground">{v.title}</h3>
          <p class="mt-3 text-[15px] leading-relaxed text-muted-foreground">{v.text}</p>
        </div>
      ))}
    </div>

    <div class="mt-16 grid items-center gap-10 rounded-3xl border border-border/70 bg-card/80 p-8 md:p-12 lg:grid-cols-[280px_1fr]">
      <div class="mx-auto h-64 w-64 overflow-hidden rounded-full bg-gradient-to-br from-primary/30 to-accent/40 ring-8 ring-background lg:mx-0">
        <div class="flex h-full w-full items-center justify-center text-primary-deep">
          <Icon name="tabler:mood-smile" class="h-24 w-24 opacity-60" />
        </div>
      </div>
      <div>
        <span class="text-xs uppercase tracking-[0.22em] text-muted-foreground">Vaše hygienistka</span>
        <h3 class="mt-3 font-display text-3xl text-foreground md:text-4xl">[Jméno hygienistky]</h3>
        <p class="mt-4 text-[15px] leading-relaxed text-muted-foreground md:text-base">
          Krátké představení — vzdělání, certifikace, přístup k pacientům a co Vás na práci nejvíc baví. Tento text doplníme podle Vašich podkladů.
        </p>
        <ul class="mt-5 grid gap-2 text-sm text-foreground/80 sm:grid-cols-2">
          {certs.map((b) => (
            <li class="flex items-center gap-2">
              <Icon name="tabler:check" class="h-4 w-4 text-primary-deep" />
              {b}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
