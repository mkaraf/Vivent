---
interface Props {
  sectionId?: string;
  iframeSrc: string;
}
const { sectionId = 'reservation', iframeSrc } = Astro.props;
---

<!-- Booking modal -->
<div
  id="booking-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4"
  aria-modal="true"
  role="dialog"
>
  <div id="booking-backdrop" class="absolute inset-0 bg-foreground/60 backdrop-blur-sm"></div>
  <div class="relative z-10 w-full max-w-3xl rounded-3xl bg-card shadow-2xl overflow-hidden">
    <div class="flex items-center justify-between border-b border-border/70 px-6 py-4">
      <span class="font-display text-xl text-foreground">Rezervace</span>
      <button
        id="booking-close"
        class="grid h-9 w-9 place-items-center rounded-full text-muted-foreground transition hover:bg-secondary hover:text-foreground"
        aria-label="Zavřít"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <iframe
      id="booking-iframe"
      src=""
      data-src={iframeSrc}
      width="100%"
      height="500"
      frameborder="0"
      class="block w-full"
    ></iframe>
  </div>
</div>

<script define:vars={{ sectionId }}>
  const modal    = document.getElementById('booking-modal');
  const backdrop = document.getElementById('booking-backdrop');
  const closeBtn = document.getElementById('booking-close');
  const iframe   = document.getElementById('booking-iframe');

  function openModal() {
    if (!iframe.src || iframe.src === window.location.href) {
      iframe.src = iframe.dataset.src;
    }
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  // Intercept any click inside the target section
  document.getElementById(sectionId)?.addEventListener('click', (e) => {
    const trigger = e.target.closest('a, button');
    if (trigger) {
      e.preventDefault();
      openModal();
    }
  });

  closeBtn.addEventListener('click', closeModal);
  backdrop.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
</script>
