---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<section class="relative not-prose" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>

  {/* Ambient botanical motifs */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="absolute -left-40 top-20 h-[320px] w-[320px] rounded-full blur-3xl sm:h-[500px] sm:w-[500px]"
      style="background-color: var(--color-sage, oklch(0.68 0.06 140)); opacity: 0.15;"
    ></div>
    <div
      class="absolute -right-20 top-1/3 h-[360px] w-[360px] rounded-full blur-3xl sm:right-0 sm:h-[600px] sm:w-[600px]"
      style="background-color: var(--color-accent, oklch(0.72 0.12 70)); opacity: 0.10;"
    ></div>
    <svg
      class="absolute left-4 top-20 h-12 w-12 animate-shimmer sm:left-12 sm:top-32 sm:h-20 sm:w-20"
      style="color: oklch(0.68 0.06 140 / 0.40);"
      viewBox="0 0 100 100"
      fill="none"
    >
      <path d="M50 10 Q70 30 50 90 Q30 30 50 10 Z" fill="currentColor"></path>
      <path d="M50 10 L50 90" stroke="oklch(0.45 0.06 140)" stroke-width="0.5"></path>
    </svg>
    <svg
      class="absolute bottom-10 right-6 h-10 w-10 rotate-45 animate-shimmer sm:bottom-24 sm:right-1/4 sm:h-16 sm:w-16"
      style="color: oklch(0.72 0.12 70 / 0.40);"
      viewBox="0 0 100 100"
      fill="none"
    >
      <path d="M50 10 Q70 30 50 90 Q30 30 50 10 Z" fill="currentColor"></path>
    </svg>
  </div>

  <div class="relative mx-auto grid max-w-7xl grid-cols-1 items-center gap-12 px-5 pb-16 pt-8 sm:gap-16 sm:px-8 sm:pb-24 sm:pt-12 lg:grid-cols-2 lg:pt-20">

    {/* Copy */}
    <div class="relative z-10 animate-fade-up">
      {
        tagline && (
          <p
            class="mb-4 text-sm font-medium uppercase tracking-widest"
            style="color: var(--color-primary);"
            set:html={tagline}
          />
        )
      }
      {
        title && (
          <h1
            class="font-display leading-[1] tracking-tight text-[2.75rem] sm:text-6xl lg:text-7xl [&_span]:italic [&_span]:text-primary"
            style="color: var(--color-foreground); letter-spacing: -0.02em;"
            set:html={title}
          />
        )
      }

      <div class="mt-8 flex items-center gap-4 sm:mt-10">
        <span class="h-px w-12" style="background-color: var(--color-accent);"></span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" style="color: var(--color-accent);">
          <path d="M12 2 Q15 8 22 12 Q15 16 12 22 Q9 16 2 12 Q9 8 12 2 Z" fill="currentColor" opacity="0.7"></path>
        </svg>
        <span class="h-px max-w-[60px] flex-1" style="background-color: var(--color-border);"></span>
      </div>

      {
        subtitle && (
          <p
            class="mt-6 max-w-md text-base leading-relaxed sm:mt-8 sm:text-lg"
            style="color: var(--color-muted-foreground);"
            set:html={subtitle}
          />
        )
      }

      {
        actions && (
          <div class="mt-8 flex flex-wrap items-center gap-3 sm:mt-12 sm:gap-4">
            {Array.isArray(actions) ? (
              actions.map((action) => (
                <div class="flex">
                  <Button {...(action || {})} class="whitespace-nowrap" />
                </div>
              ))
            ) : (
              <Fragment set:html={actions} />
            )}
          </div>
        )
      }

      {content && <Fragment set:html={content} />}
    </div>

    {/* Visual */}
    <div class="relative">
      {
        image && (
          <div class="relative mx-auto aspect-square w-full max-w-[340px] sm:max-w-[600px]">
            <div class="absolute inset-0 rounded-full border" style="border-color: oklch(0.72 0.12 70 / 0.15);"></div>
            <div class="absolute inset-4 rounded-full border sm:inset-8" style="border-color: oklch(0.68 0.06 140 / 0.20);"></div>
            <div class="absolute inset-8 rounded-full sm:inset-16" style="background: radial-gradient(circle, oklch(0.975 0.014 80 / 0.60) 0%, transparent 70%);"></div>

            {typeof image === 'string' ? (
              <Fragment set:html={image} />
            ) : (
              <Image
                class="relative z-10 h-full w-full animate-float-slow object-contain"
                widths={[400, 768, 1024]}
                sizes="(max-width: 767px) 340px, 600px"
                loading="eager"
                layout="responsive"
                {...image}
              />
            )}

            <div
              class="absolute -right-2 bottom-8 z-20 animate-fade-up rounded-2xl border px-3 py-2 shadow-xl backdrop-blur sm:-right-4 sm:bottom-16 sm:px-5 sm:py-3"
              style="border-color: var(--color-border); background-color: oklch(0.975 0.014 80 / 0.90);"
            >
              <div class="flex items-center gap-2">
                <span class="h-2 w-2 animate-pulse rounded-full" style="background-color: var(--color-primary);"></span>
                <span class="text-[11px] sm:text-xs" style="color: var(--color-muted-foreground);">
                  Volné termíny tento týden
                </span>
              </div>
            </div>
          </div>
        )
      }
    </div>

  </div>

  {/* Bottom section divider */}
  <div class="mx-auto max-w-7xl px-8">
    <div class="h-px" style="background: linear-gradient(to right, transparent, var(--color-border), transparent);"></div>
  </div>
</section>
