---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<section class="relative not-prose overflow-hidden" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 pb-8 md:pt-0 md:pb-12">
      <div class="grid grid-cols-1 md:grid-cols-[1fr,2fr] gap-8 md:gap-12 items-center">

        {/* Text Content */}
        <div class="order-2 md:order-1 text-center md:text-left pb-10 md:pb-0 flex flex-col items-center md:items-start">
          {
            tagline && (
              <p
                class="text-base text-secondary font-bold tracking-wide uppercase animate-fade"
                set:html={tagline}
              />
            )
          }
          {
            title && (
              <h1
                class="text-4xl md:text-4xl lg:text-5xl font-extrabold leading-[1.1] tracking-tighter mb-10 font-heading animate-fade"
                set:html={title}
              />
            )
          }
          <div class="max-w-sm">
            {
              subtitle && (
                <p
                  class="text-lg text-default mb-12 animate-fade font-light leading-relaxed tracking-wide"
                  set:html={subtitle}
                />
              )
            }
            {
              actions && (
                <div class="flex flex-nowrap flex-row gap-4 justify-center md:justify-start animate-fade">
                  {Array.isArray(actions) ? (
                    actions.map((action) => (
                      <div class="flex">
                        <Button {...(action || {})} class="whitespace-nowrap" />
                      </div>
                    ))
                  ) : (
                    <Fragment set:html={actions} />
                  )}
                </div>
              )
            }
          </div>
          {content && <Fragment set:html={content} />}
        </div>

        {/* Image Content */}
        <div class="order-1 md:order-2 animate-fade">
          {
            image && (
              <div class="relative w-full flex justify-center">
{typeof image === 'string' ? (
                  <Fragment set:html={image} />
                ) : (
                  <Image
                    class="relative w-full drop-shadow-xl"
                    style="border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;"
                    widths={[400, 768, 1024, 2040]}
                    sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
                    loading="eager"
                    layout="responsive"
                    {...image}
                  />
                )}
              </div>
            )
          }
        </div>

      </div>
    </div>
  </div>
</section>
