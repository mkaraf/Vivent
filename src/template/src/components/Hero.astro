---
import { Icon } from 'astro-icon/components';
---
<section class="relative overflow-hidden grain">
  <div aria-hidden class="pointer-events-none absolute -top-32 -left-32 h-[520px] w-[520px] rounded-full opacity-50 blur-3xl" style="background: radial-gradient(closest-side, oklch(0.85 0.04 145 / 0.55), transparent);"></div>
  <div aria-hidden class="pointer-events-none absolute -bottom-40 right-0 h-[480px] w-[480px] rounded-full opacity-60 blur-3xl" style="background: radial-gradient(closest-side, oklch(0.88 0.05 85 / 0.55), transparent);"></div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-2 lg:gap-16 lg:py-28">
    <div class="relative">
      <span class="inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5 text-[12px] font-medium uppercase tracking-[0.18em] text-primary-deep">
        <Icon name="lucide:sparkles" class="h-3.5 w-3.5" />
        Šetrná péče · Zlín
      </span>
      <h1 class="mt-6 font-serif text-5xl leading-[1.02] tracking-tight text-foreground md:text-6xl lg:text-7xl">
        Dentální hygiena <span class="italic text-primary-deep">ve Zlíně</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground md:text-xl">
        Profesionální péče pro Váš krásný úsměv. Klidné prostředí, moderní přístup a citlivý přístup ke každému pacientovi.
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href="#rezervace" class="inline-flex items-center gap-2 rounded-full bg-primary px-7 py-3.5 text-base font-semibold text-primary-foreground transition hover:bg-primary-deep hover:-translate-y-px" style="box-shadow: 0 18px 40px -18px oklch(0.48 0.07 145 / 0.6);">Objednat se</a>
        <a href="#sluzby" class="inline-flex items-center gap-2 rounded-full border border-foreground/15 bg-background/60 px-6 py-3.5 text-base font-semibold text-foreground transition hover:border-foreground/30 hover:bg-secondary">Naše služby</a>
      </div>
      <dl class="mt-12 grid max-w-md grid-cols-3 gap-6 border-t border-border/70 pt-8">
        <div><dt class="font-serif text-3xl text-primary-deep">12+</dt><dd class="mt-1 text-xs uppercase tracking-wider text-muted-foreground">let praxe</dd></div>
        <div><dt class="font-serif text-3xl text-primary-deep">4 800+</dt><dd class="mt-1 text-xs uppercase tracking-wider text-muted-foreground">spokojených úsměvů</dd></div>
        <div><dt class="font-serif text-3xl text-primary-deep">5.0</dt><dd class="mt-1 text-xs uppercase tracking-wider text-muted-foreground">hodnocení Google</dd></div>
      </dl>
    </div>

    <div class="relative mx-auto w-full max-w-[560px]">
      <div aria-hidden class="absolute -inset-6 hero-blob bg-primary/15" style="border-radius: 58% 42% 60% 40% / 52% 48% 52% 48%;"></div>
      <div class="hero-blob relative overflow-hidden bg-card">
        <img src="/assets/hero-family.jpg" alt="Klidná atmosféra dentálního studia SanaDenta ve Zlíně" width="1024" height="1024" class="h-full w-full object-cover" />
      </div>
      <div class="absolute -bottom-4 -left-2 md:-left-8 flex items-center gap-3 rounded-2xl border border-border/70 bg-card/95 px-4 py-3 backdrop-blur" style="box-shadow: var(--shadow-soft);">
        <div class="grid h-10 w-10 place-items-center rounded-full bg-primary/15 text-primary-deep">
          <Icon name="lucide:sparkles" class="h-5 w-5" />
        </div>
        <div class="leading-tight">
          <div class="text-sm font-semibold text-foreground">Šetrná hygiena AirFlow</div>
          <div class="text-xs text-muted-foreground">Bezbolestně · moderně · prémiově</div>
        </div>
      </div>
    </div>
  </div>
</section>
