---
import SectionHeading from './SectionHeading.astro';
import { Phone, Mail, MapPin, Clock, ArrowRight } from '@lucide/astro';

const CONTACT = {
  phone: '+420 777 123 456',
  phoneHref: 'tel:+420777123456',
  email: 'info@sanadenta.cz',
  address: 'Náměstí Míru 12, 760 01 Zlín',
  mapsQuery: 'SanaDenta Zlín',
};

const HOURS = [
  { day: 'Pondělí – Čtvrtek', time: '8:00 – 17:00' },
  { day: 'Pátek', time: '8:00 – 14:00' },
  { day: 'Sobota – Neděle', time: 'Zavřeno' },
];
---
<section id="kontakt" class="relative py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-6">
    <SectionHeading
      eyebrow="Kontakt"
      title="Objednejte se na <em class='font-serif italic text-primary'>vyšetření</em>"
      intro="Rezervujte si svůj termín telefonicky, e-mailem, nebo se zastavte přímo v ordinaci."
    />

    <div class="mt-16 grid gap-10 lg:grid-cols-2">
      <div class="space-y-8">
        <div class="space-y-4">
          <a href={CONTACT.phoneHref} class="group flex items-center gap-4 rounded-2xl border border-border bg-card p-5 transition hover:border-primary/40 hover:shadow-md">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary-deep">
              <Phone class="h-5 w-5" />
            </span>
            <span class="flex-1">
              <span class="block text-xs uppercase tracking-[0.18em] text-muted-foreground">Telefon</span>
              <span class="block text-lg font-medium text-foreground">{CONTACT.phone}</span>
            </span>
            <ArrowRight class="h-4 w-4 text-muted-foreground transition group-hover:translate-x-1 group-hover:text-primary-deep" />
          </a>

          <a href={`mailto:${CONTACT.email}`} class="group flex items-center gap-4 rounded-2xl border border-border bg-card p-5 transition hover:border-primary/40 hover:shadow-md">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary-deep">
              <Mail class="h-5 w-5" />
            </span>
            <span class="flex-1">
              <span class="block text-xs uppercase tracking-[0.18em] text-muted-foreground">E-mail</span>
              <span class="block text-lg font-medium text-foreground">{CONTACT.email}</span>
            </span>
            <ArrowRight class="h-4 w-4 text-muted-foreground transition group-hover:translate-x-1 group-hover:text-primary-deep" />
          </a>

          <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(CONTACT.mapsQuery)}`} target="_blank" rel="noopener" class="group flex items-center gap-4 rounded-2xl border border-border bg-card p-5 transition hover:border-primary/40 hover:shadow-md">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary-deep">
              <MapPin class="h-5 w-5" />
            </span>
            <span class="flex-1">
              <span class="block text-xs uppercase tracking-[0.18em] text-muted-foreground">Adresa</span>
              <span class="block text-lg font-medium text-foreground">{CONTACT.address}</span>
            </span>
            <ArrowRight class="h-4 w-4 text-muted-foreground transition group-hover:translate-x-1 group-hover:text-primary-deep" />
          </a>
        </div>

        <div class="rounded-2xl border border-border bg-card p-6">
          <div class="flex items-center gap-3">
            <Clock class="h-5 w-5 text-primary-deep" />
            <h3 class="font-serif text-xl text-foreground">Otevírací doba</h3>
          </div>
          <ul class="mt-4 divide-y divide-border">
            {HOURS.map(({ day, time }) => (
              <li class="flex items-center justify-between py-3 text-sm">
                <span class="text-foreground">{day}</span>
                <span class="font-medium text-muted-foreground">{time}</span>
              </li>
            ))}
          </ul>
          <a href={CONTACT.phoneHref} class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-full bg-primary-deep px-6 py-3 text-sm font-medium text-white transition hover:bg-primary">
            Zavolat nyní
            <ArrowRight class="h-4 w-4" />
          </a>
        </div>

        <p class="text-center text-sm text-muted-foreground">
          Bezbariérový přístup · Parkování zdarma · MHD 2 minuty pěšky
        </p>
      </div>

      <div class="overflow-hidden rounded-3xl border border-border bg-card shadow-sm min-h-[480px]">
        <iframe
          title="Mapa SanaDenta"
          src={`https://www.google.com/maps?q=${encodeURIComponent(CONTACT.mapsQuery)}&output=embed`}
          loading="lazy"
          class="h-full w-full"
          style="border:0; min-height:480px;"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>
