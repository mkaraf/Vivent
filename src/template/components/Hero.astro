---
import heroImg from "../assets/hero-family.jpg";

const STATS = [
  { k: "12+", v: "let praxe" },
  { k: "4 800+", v: "spokojených úsměvů" },
  { k: "5.0", v: "hodnocení Google" },
];
---
<section class="relative overflow-hidden grain">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-32 -left-32 h-[520px] w-[520px] rounded-full opacity-50 blur-3xl"
    style="background: radial-gradient(closest-side, oklch(0.85 0.04 145 / 0.55), transparent);"
  ></div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -bottom-40 right-0 h-[480px] w-[480px] rounded-full opacity-60 blur-3xl"
    style="background: radial-gradient(closest-side, oklch(0.88 0.05 85 / 0.55), transparent);"
  ></div>

  <div class="relative mx-auto grid max-w-7xl items-center gap-12 px-5 py-16 md:px-8 md:py-24 lg:grid-cols-2 lg:gap-16 lg:py-28">
    <div class="relative">
      <span class="inline-flex items-center gap-2 rounded-full border border-(--color-primary)/30 bg-(--color-primary)/10 px-4 py-1.5 text-[12px] font-medium uppercase tracking-[0.18em] text-(--color-primary-deep)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.4 5.4 5.6.8-4 4 .9 5.6L12 16l-4.9 2.8L8 13.2l-4-4 5.6-.8L12 3z"/></svg>
        Šetrná péče · Zlín
      </span>

      <h1 class="mt-6 font-serif text-5xl leading-[1.02] tracking-tight text-(--color-foreground) md:text-6xl lg:text-7xl">
        Dentální hygiena <span class="italic text-(--color-primary-deep)">ve Zlíně</span>
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-(--color-muted-foreground) md:text-xl">
        Profesionální péče pro Váš krásný úsměv. Klidné prostředí, moderní přístup a citlivý přístup ke každému pacientovi.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href="#rezervace"
          class="inline-flex items-center gap-2 rounded-full bg-(--color-primary) px-7 py-3.5 text-base font-semibold text-(--color-primary-foreground) transition hover:bg-(--color-primary-deep) hover:-translate-y-px"
          style="box-shadow: 0 18px 40px -18px oklch(0.48 0.07 145 / 0.6);"
        >
          Objednat se
        </a>
        <a
          href="#sluzby"
          class="inline-flex items-center gap-2 rounded-full border border-(--color-foreground)/15 bg-(--color-background)/60 px-6 py-3.5 text-base font-semibold text-(--color-foreground) transition hover:border-(--color-foreground)/30 hover:bg-(--color-secondary)"
        >
          Naše služby
        </a>
      </div>

      <dl class="mt-12 grid max-w-md grid-cols-3 gap-6 border-t border-(--color-border)/70 pt-8">
        {STATS.map((s) => (
          <div>
            <dt class="font-serif text-3xl text-(--color-primary-deep)">{s.k}</dt>
            <dd class="mt-1 text-xs uppercase tracking-wider text-(--color-muted-foreground)">{s.v}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="relative mx-auto w-full max-w-[560px]">
      <div
        aria-hidden="true"
        class="absolute -inset-6 hero-blob bg-(--color-primary)/15"
        style="border-radius: 58% 42% 60% 40% / 52% 48% 52% 48%;"
      ></div>
      <div class="hero-blob relative overflow-hidden bg-(--color-card)">
        <img
          src={heroImg.src}
          alt="Klidná atmosféra dentálního studia SanaDenta ve Zlíně"
          width="1024"
          height="1024"
          class="h-full w-full object-cover"
        />
      </div>

      <div class="absolute -bottom-4 -left-2 md:-left-8 flex items-center gap-3 rounded-2xl border border-(--color-border)/70 bg-(--color-card)/95 px-4 py-3 backdrop-blur" style="box-shadow: var(--shadow-soft);">
        <div class="grid h-10 w-10 place-items-center rounded-full bg-(--color-primary)/15 text-(--color-primary-deep)">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.4 5.4 5.6.8-4 4 .9 5.6L12 16l-4.9 2.8L8 13.2l-4-4 5.6-.8L12 3z"/></svg>
        </div>
        <div class="leading-tight">
          <div class="text-sm font-semibold text-(--color-foreground)">Šetrná hygiena AirFlow</div>
          <div class="text-xs text-(--color-muted-foreground)">Bezbolestně · moderně · prémiově</div>
        </div>
      </div>
    </div>
  </div>
</section>
