---
import logoImg from "../assets/logo-tooth.png";

const NAV = [
  { label: "O nás", href: "#o-nas" },
  { label: "Služby", href: "#sluzby" },
  { label: "Ceník", href: "#cenik" },
  { label: "Rezervace", href: "#rezervace" },
  { label: "Kontakt", href: "#kontakt" },
  { label: "FAQ", href: "#faq" },
];
---
<header class="sticky top-0 z-40 border-b border-(--color-border)/60 bg-(--color-background)/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4 md:px-8 md:py-5">
    <a href="/" class="flex items-center gap-3">
      <img
        src={logoImg.src}
        alt=""
        width="56"
        height="56"
        class="h-12 w-12 md:h-14 md:w-14 object-contain mix-blend-multiply"
      />
      <div class="flex flex-col leading-none">
        <span class="font-serif text-2xl md:text-[28px] font-semibold tracking-tight">
          <span class="text-(--color-foreground)">Sana</span>
          <span class="text-(--color-primary-deep)">Denta</span>
        </span>
        <span class="mt-1 text-[11px] uppercase tracking-[0.22em] text-(--color-muted-foreground)">
          Dentální studio · Zlín
        </span>
      </div>
    </a>

    <nav class="hidden lg:flex items-center gap-1">
      {NAV.map((n) => (
        <a
          href={n.href}
          class="relative px-3.5 py-2 text-[15px] font-medium text-(--color-foreground)/80 transition-colors hover:text-(--color-primary-deep)"
        >
          {n.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <div class="hidden md:flex items-center gap-1">
        <a href="#" aria-label="Instagram" class="grid h-10 w-10 place-items-center rounded-full text-(--color-foreground)/70 transition hover:bg-(--color-secondary) hover:text-(--color-primary-deep)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="#" aria-label="Facebook" class="grid h-10 w-10 place-items-center rounded-full text-(--color-foreground)/70 transition hover:bg-(--color-secondary) hover:text-(--color-primary-deep)">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
      </div>
      <a
        href="#rezervace"
        class="hidden md:inline-flex items-center gap-2 rounded-full bg-(--color-primary) px-5 py-2.5 text-sm font-semibold text-(--color-primary-foreground) shadow-sm transition hover:bg-(--color-primary-deep)"
      >
        Objednat se
      </a>
      <button
        id="menu-toggle"
        class="lg:hidden grid h-10 w-10 place-items-center rounded-full text-(--color-foreground)/80 hover:bg-(--color-secondary)"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
      </button>
    </div>
  </div>
  <div id="mobile-nav" class="hidden lg:hidden border-t border-(--color-border)/60 bg-(--color-background)">
    <nav class="mx-auto flex max-w-7xl flex-col px-5 py-3">
      {NAV.map((n) => (
        <a href={n.href} class="py-3 text-base font-medium text-(--color-foreground)/85 hover:text-(--color-primary-deep)">
          {n.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-toggle");
  const nav = document.getElementById("mobile-nav");
  btn?.addEventListener("click", () => {
    const isHidden = nav?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", String(!isHidden));
  });
  nav?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      nav.classList.add("hidden");
      btn?.setAttribute("aria-expanded", "false");
    })
  );
</script>
